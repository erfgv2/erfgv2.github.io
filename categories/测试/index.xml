&lt;p&gt;int add(int num1, int num2)
{
return num1 + num2;
}&lt;/p&gt;
&lt;p&gt;int main()
{
int a = 1, b = 2;          // 同一行声明并赋值
printf(&amp;quot;%d\n&amp;quot;, add(a, b)); // 直接输出返回值
return 0;
}&lt;/p&gt;
